<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="HBox" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1" spacing="8.0">
    <children>
        <ImageView fx:id="displayPicture" fitHeight="40.0" fitWidth="40.0"
                   preserveRatio="true" smooth="true" />
        <Label fx:id="dialog" minHeight="40.0" wrapText="true">
            <padding>
                <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
            </padding>
        </Label>
    </children>
</fx:root>
